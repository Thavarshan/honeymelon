{
  "name": "@honeymelon/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./config": "./dist/config.js",
    "./converter-page": "./dist/converter-page.js",
    "./desktop": "./dist/desktop.js",
    "./media": "./dist/media.js",
    "./upload": "./dist/upload.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.harness.json",
    "test:desktop": "playwright test --project=desktop",
    "test:matrix": "playwright test --project=native-matrix",
    "test": "vitest run",
    "harness:build": "vite build --config vite.harness.config.ts",
    "test:browser": "npm run harness:build && playwright test --config playwright.browser.config.ts",
    "test:site": "playwright test --config playwright.site.config.ts",
    "test:web": "playwright test --config playwright.web.config.ts"
  },
  "dependencies": {
    "@honeymelon/browser-engine": "*",
    "@honeymelon/contracts": "*",
    "@honeymelon/converter": "*",
    "@honeymelon/core": "*",
    "@honeymelon/engine": "*",
    "@honeymelon/ui": "*",
    "@playwright/test": "1.65.0",
    "zod": "4.6.7",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "i18next": "26.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "tailwindcss": "4.3.4",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
