{
  "name": "@honeymelon/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./styles/*": "./src/styles/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "vitest run",
    "gallery": "vite --host 127.0.0.1",
    "gallery:build": "vite build --outDir .gallery"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5",
    "shadcn": "4.22.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "lucide-react": "0.577.0",
    "radix-ui": "1.8.1",
    "tw-animate-css": "1.4.0"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  }
}
