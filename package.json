{
  "name": "honeymelon-monorepo",
  "version": "3.0.0-beta.2",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=12.2.0 <13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "start": "npm run dev",
    "lint": "npm run build:packages && eslint . && node scripts/check-boundaries.mjs",
    "lint:fix": "npm run build:packages && prettier --write . && eslint . --fix && prettier --write . && node scripts/check-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "npm run test:integration -w @honeymelon/engine",
    "test:e2e": "npm run test:desktop -w @honeymelon/e2e",
    "build": "turbo run build",
    "package": "turbo run package --filter=@honeymelon/desktop",
    "make": "turbo run make --filter=@honeymelon/desktop",
    "binaries": "node scripts/stage-binaries.mjs",
    "postinstall": "node scripts/prepare-tools.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:packaged": "node scripts/verify-packaged.mjs",
    "test:packaged": "npm run verify:packaged && node scripts/test-packaged.mjs",
    "ui:dev": "npm run gallery -w @honeymelon/ui",
    "ui:build": "npm run gallery:build -w @honeymelon/ui",
    "test:matrix": "turbo run test:matrix --filter=@honeymelon/e2e",
    "test:ci": "node --test scripts/tests/*.test.mjs",
    "dist:portable": "node scripts/portable.mjs",
    "build:packages": "turbo run build --filter=./packages/*",
    "build:browser": "turbo run build --filter=./packages/* --filter=./apps/* --filter=!@honeymelon/desktop",
    "test:site": "turbo run test:site --filter=@honeymelon/e2e --",
    "test:browser": "turbo run test:browser --filter=@honeymelon/e2e --",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "brand:screenshots": "node scripts/capture-brand-screenshots.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Thavarshan/honeymelon.git"
  },
  "license": "MIT",
  "allowScripts": {
    "electron-winstaller": false,
    "fsevents": false
  }
}
