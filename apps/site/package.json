{
  "name": "@honeymelon/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/prepare-release-snapshot.mjs && next build && node scripts/verify-export.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test scripts/*.test.mjs",
    "releases:refresh": "node scripts/refresh-releases.mjs"
  },
  "dependencies": {
    "@honeymelon/contracts": "*",
    "@honeymelon/ui": "*",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "0.577.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "wrangler": "4.152.0"
  }
}
