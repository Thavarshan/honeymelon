{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.js",
    "tsconfig.browser.json",
    ".prettierrc.js",
    ".prettierignore",
    ".editorconfig"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".vite/**",
        ".bundle/**",
        ".next/**",
        "!.next/cache/**",
        "out/**"
      ],
      "env": ["HONEYMELON_SITE_URL", "HONEYMELON_WEB_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "package": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "make": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:matrix": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:site": {
      "cache": false,
      "dependsOn": ["@honeymelon/site#build"],
      "outputs": []
    },
    "test:browser": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:web": {
      "cache": false,
      "dependsOn": ["^build", "@honeymelon/web#build"],
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "HONEYMELON_*",
    "APPLE_*",
    "WINDOWS_CERTIFICATE_*",
    "ELECTRON_CACHE"
  ]
}
